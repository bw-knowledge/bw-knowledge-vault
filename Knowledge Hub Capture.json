    {
      "parameters": {
        "jsCode": "const checkResult = $input.first();\nconst sourceIndexExists = !checkResult.error && !checkResult.json?.error;\nconst incoming = $('Extract URL').first().json;\nconst chatId = $('Session Manager').first().json.chatId;\n\nfunction normaliseUrl(value) {\n  if (!value) return '';\n  try {\n    const parsed = new URL(value.trim());\n    parsed.hash = '';\n    if (parsed.pathname !== '/') parsed.pathname = parsed.pathname.replace(/\\/+$/, '');\n    return parsed.toString();\n  } catch (error) {\n    return value.trim().replace(/\\/+$/, '');\n  }\n}\n\nfunction readContent(json) {\n  if (!json) return '';\n  if (typeof json.fileContent === 'string') return json.fileContent;\n  if (typeof json.content === 'string') {\n    try {\n      return Buffer.from(json.content.replace(/\\s/g, ''), 'base64').toString('utf8');\n    } catch (error) {\n      return json.content;\n    }\n  }\n  if (typeof json.data === 'string') return json.data;\n  if (json.data && typeof json.data.content === 'string') {\n    try {\n      return Buffer.from(json.data.content.replace(/\\s/g, ''), 'base64').toString('utf8');\n    } catch (error) {\n      return json.data.content;\n    }\n  }\n  return '';\n}\n\nfunction parseSources(content) {\n  if (!content.trim()) return {};\n  try {\n    const parsed = JSON.parse(content);\n    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};\n  } catch (error) {\n    throw new Error('Unable to parse Indexes/sources.json: ' + error.message);\n  }\n}\n\nfunction escapeHtml(value) {\n  return String(value || '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n}\n\nconst sources = parseSources(readContent(checkResult.json));\nconst normalisedUrl = normaliseUrl(incoming.url);\nconst existingPath = sources[normalisedUrl];\nconst duplicateArticle = Boolean(existingPath);\nconst text = duplicateArticle\n  ? ['Already captured', '', escapeHtml(incoming.url), '', 'Matched on source URL.', '', 'Vault path: <code>' + escapeHtml(existingPath) + '</code>'].join('\\n')\n  : '';\n\nreturn [{ json: { ...incoming, chatId, sourceIndexExists, sources, normalisedUrl, duplicateArticle, duplicateReason: duplicateArticle ? 'same source URL' : '', path: existingPath || '', text } }];"
      },
