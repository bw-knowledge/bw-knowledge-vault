      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst sessions = staticData.knowledgeHubSessions || {};\nconst SESSION_TTL = 30 * 60 * 1000;\n\nconst msg = $input.first().json.message;\nconst chatId = msg.chat.id.toString();\nconst text = (msg.text || '').trim().replace(/@\\w+$/, '').trim();\nconst now = Date.now();\n\n// Clean expired sessions\nfor (const [id, s] of Object.entries(sessions)) {\n  if (now - s.lastActivity > SESSION_TTL) delete sessions[id];\n}\n\n// /cancel or /reset\nif (text === '/cancel' || text === '/reset') {\n  delete sessions[chatId];\n  staticData.knowledgeHubSessions = sessions;\n  return [{ json: { action: 'cancelled', chatId, text, message: msg } }];\n}\n\n// Touch/init session\nif (!sessions[chatId]) {\n  sessions[chatId] = { state: 'idle', lastActivity: now };\n} else {\n  sessions[chatId].lastActivity = now;\n}\nstaticData.knowledgeHubSessions = sessions;\n\nreturn [{ json: { action: 'continue', chatId, text, message: msg } }];"
      },
