    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst chatId = $('Session Manager').first().json.chatId;\n\nconst errorItem = items.find(item => item.json.error);\nif (errorItem) {\n  const error = errorItem.json.error;\n  const message = typeof error === 'string' ? error : (error.message || JSON.stringify(error));\n  return [{ json: { chatId, text: 'Unable to list topics from GitHub: ' + message } }];\n}\n\nconst topics = items\n  .map(item => item.json.name)\n  .filter(name => name && name.endsWith('.md'))\n  .map(name => name.replace(/\\.md$/, ''))\n  .sort();\n\nconst text = topics.length === 0\n  ? 'No topics yet...'\n  : 'Available topics:\\n' + topics.map(t => '- ' + t).join('\\n');\n\nreturn [{ json: { chatId, text } }];"
      },
