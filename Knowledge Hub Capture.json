    {
      "parameters": {
        "jsCode": "const firecrawlResult = $('Firecrawl Scrape').first().json;\nconst firecrawlData = firecrawlResult.data || firecrawlResult;\nconst markdown = firecrawlData.markdown || '';\nconst title = firecrawlData.metadata?.title || 'Untitled';\nconst url = $('Extract URL').first().json.url;\n\nconst topicsItems = $('GitHub List Topics Capture').all();\nconst topicListError = topicsItems.find(item => item.json.error);\nif (topicListError) {\n  const error = topicListError.json.error;\n  const message = typeof error === 'string' ? error : (error.message || JSON.stringify(error));\n  throw new Error('Unable to list topics from GitHub: ' + message);\n}\n\nconst existingTopics = topicsItems\n  .map(item => item.json.name)\n  .filter(name => name && name.endsWith('.md'))\n  .map(name => name.replace(/\\.md$/, ''))\n  .sort();\n\nconst matchedTopicsSection = existingTopics.length > 0\n  ? '## Matched Topics\\n\\n[From this list of existing vault topics - ' + existingTopics.join(', ') + ' - identify any this article clearly relates to, comma-separated. Be conservative. If none match, write \"None\".]'\n  : '';\n\nconst truncatedContent = markdown.length > 40000 ? markdown.substring(0, 40000) + '\\n\\n[Content truncated]' : markdown;\n\nconst prompt = [\n  'You are extracting key information from an article for a personal knowledge vault.',\n  '',\n  'Output the following sections in markdown. Do not include any preamble or explanation outside these sections.',\n  '',\n  'In summary, [the most interesting aspect, delivered as a complete declarative statement starting with this exact phrase].',\n  '',\n  '## Suggested Topics',\n  '',\n  '[Freely suggest 1-3 topic names that best describe this article. Choose names that are concise (1-3 words), specific enough to be useful but general enough to gather multiple articles. Plain text, comma-separated. Do NOT use [[wikilinks]].]',\n  '',\n  matchedTopicsSection,\n  '',\n  '## Headlines',\n  '',\n  '- **[A bold, declarative headline ending with a period.]** [1-2 supporting sentences with the specifics.]',\n  '- **[Next headline.]** [Supporting sentences.]',\n  '- [3-5 headlines total]',\n  '',\n  '## Things',\n  '',\n  '- **People:** [comma-separated names mentioned]',\n  '- **Places:** [comma-separated places or product surfaces]',\n  '- **Numbers:** [specific statistics, dates, quantities - semicolon-separated]',\n  '- **Things:** [products, tools, frameworks, named systems]',\n  '- **Concepts:** [abstract concepts, terms of art]',\n  '',\n  '---',\n  '',\n  'Article title: ' + title,\n  'Article source: ' + url,\n  '',\n  'Article content:',\n  truncatedContent,\n].join('\\n');\n\nreturn [{ json: { prompt, title, url } }];"
      },
      "id": "46467e87-d4ab-4076-92e5-086efd1b8431",
      "name": "Build Anthropic Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2176,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const anthropicResponse = $input.first().json;\nconst body = anthropicResponse.text || '';\nconst promptData = $('Build Anthropic Prompt').first().json;\nconst title = promptData.title;\nconst url = promptData.url;\nconst firecrawlData = $('Firecrawl Scrape').first().json;\nconst firecrawlInner = firecrawlData.data || firecrawlData;\nconst fullText = firecrawlInner.markdown || '';\n\n\nconst now = new Date();\nconst isoTimestamp = now.toISOString();\nconst dateStr = isoTimestamp.split('T')[0];\n\nconst escapedTitle = title.replace(/\"/g, '\\\\\"');\n\nconst frontmatter = `---\\ntitle: \"${escapedTitle}\"\\ncreated: ${dateStr}\\nsource: \"${url}\"\\ntags:\\nContentType: \"Article\"\\ncaptured_via: \"Telegram\"\\ncaptured_at: \"${isoTimestamp}\"\\n---`;\n\nconst clipping = `${frontmatter}\\n\\n${body}\\n\\n---\\n\\n## Full Article\\n\\n${fullText}`;\n\nreturn [{ json: { clipping, body, title, url, dateStr } }];"
      },
      "id": "afe96192-4dc4-4ee8-acb9-70a121a48275",
      "name": "Build Clipping",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2864,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const { title, clipping, body, url, dateStr } = $input.first().json;\n\n// Sanitise: strip / \\ : * ? \" < > |, collapse whitespace, trim to 100 chars\nconst sanitised = title\n  .replace(/[\\/\\\\:*?\"<>|]/g, '')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .substring(0, 100) || 'Untitled';\n\nconst filename = sanitised + '.md';\nconst path = 'Clippings/Telegram/' + filename;\n\nreturn [{ json: { filename, path, clipping, body, title, url, dateStr } }];"
      },
      "id": "c25d4fe5-ab5b-4b03-9df1-8061b0ad0a91",
      "name": "Build Filename",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3104,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const checkResult = $input.first();\nconst buildData = $('Build Filename').first().json;\n\n// With onError: continueRegularOutput, a missing GitHub file appears as an error item.\n// If there is no error, the title-derived path already exists and should not be captured again.\nconst fileExists = !checkResult.error && !checkResult.json?.error;\n\nfunction escapeHtml(value) {\n  return String(value || '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n}\n\nlet filename = buildData.filename;\nlet path = buildData.path;\nlet duplicateArticle = false;\nlet duplicateReason = '';\n\nif (fileExists) {\n  duplicateArticle = true;\n  duplicateReason = 'same filename already exists';\n}\n\nconst commitMessage = 'Capture: ' + buildData.title;\nconst text = duplicateArticle\n  ? [\n      'Already captured',\n      '',\n      escapeHtml(buildData.title),\n      '',\n      'Matched on ' + escapeHtml(duplicateReason) + '.',\n      '',\n      'Vault path: <code>' + escapeHtml(buildData.path) + '</code>',\n    ].join('\\n')\n  : '';\n\nreturn [{ json: { filename, path, commitMessage, title: buildData.title, url: buildData.url, body: buildData.body, clipping: buildData.clipping, duplicateArticle, duplicateReason, chatId: $('Session Manager').first().json.chatId, text } }];"
      },
      "id": "5342585c-4e35-4708-be8b-c116a83117ab",
      "name": "Resolve Filename",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3648,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const resolveData = $('Resolve Filename').first().json;\nconst body = resolveData.body || '';\nconst title = resolveData.title;\nconst filename = resolveData.filename;\nconst chatId = $('Session Manager').first().json.chatId;\n\nfunction escapeHtml(value) {\n  return String(value || '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n}\n\n// Extract 'In summary,' sentence\nconst summaryMatch = body.match(/^In summary,\\s*(.+)/m);\nconst summaryLine = summaryMatch ? ('In summary, ' + summaryMatch[1].trim()).substring(0, 220) : body.substring(0, 200);\n\n// Extract Suggested Topics\nconst topicsMatch = body.match(/## Suggested Topics\\s*\\n+([^\\n#]+)/);\nconst suggestedTopics = topicsMatch ? topicsMatch[1].trim() : 'See clipping';\n\nconst text = [\n  'Captured',\n  '',\n  escapeHtml(title),\n  '',\n  escapeHtml(summaryLine),\n  '',\n  'Suggested topics: ' + escapeHtml(suggestedTopics),\n  '',\n  'Vault path: <code>Clippings/Telegram/' + escapeHtml(filename) + '</code>',\n].join('\\n');\n\nreturn [{ json: { chatId, text } }];"
      },
