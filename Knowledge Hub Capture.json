        "jsCode": "const resolveData = $('Resolve Filename').first().json;\nconst sourceIndexData = $('Check Source Index').first().json;\nconst sources = sourceIndexData.sources && typeof sourceIndexData.sources === 'object' ? sourceIndexData.sources : {};\nsources[sourceIndexData.normalisedUrl] = resolveData.path;\n\nconst sourceIndexContent = JSON.stringify(sources, Object.keys(sources).sort(), 2) + '\\n';\nconst commitMessage = 'Update source index: ' + resolveData.title;\n\nreturn [{ json: { ...resolveData, sourceIndexExists: sourceIndexData.sourceIndexExists, sourceIndexPath: 'Indexes/sources.json', sourceIndexContent, commitMessage } }];"
