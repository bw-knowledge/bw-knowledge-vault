filters:
  and:
    - ContentType == "Article"
formulas:
  Domain: source.toString().replace(/^(?:https?:\/\/)?(?:www\.)?([^\/?#]+).*$/, "$1")
properties:
  formula.Domain:
    displayName: Domain
views:
  - type: table
    name: Table
    order:
      - file.name
      - formula.Domain
      - source
    sort:
      - property: formula.Domain
        direction: ASC
    columnSize:
      file.name: 300
      formula.Domain: 175
  - type: table
    name: Digital PR
    filters:
      or:
        - file.hasLink("Topics/Digital PR.md")
    order:
      - file.name
      - formula.Domain
      - author
      - source
      - watched
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 261
      source: 218
  - type: table
    name: Generative Engine Optimisation (GEO)
