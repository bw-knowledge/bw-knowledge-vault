filters:
  and:
    - ContentType == "Article"
views:
  - type: table
    name: Table

  - type: table
    name: Digital PR
    filters:
      or:
        - file.hasLink("Topics/Digital PR.md")
    order:
      - file.name
      - author
      - source
      - watched
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 261
      note.source: 218
  - type: table
    name: Generative Engine Optimisation (GEO)
    filters:
      or:
        - file.hasLink("Topics/Generative Engine Optimisation (GEO).md")
    order:
      - file.name
      - author
      - source
      - watched
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 261
      note.source: 218
  - type: table
    name: SEO
    filters:
      or:
        - file.hasLink("Topics/SEO.md")
    order:
      - file.name
      - author
      - source
      - watched
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 261
      note.source: 218